{
  "packageId": "ts-orders-dynamo",
  "goldVersion": "0.1.0",
  "tier": "stretch",
  "description": "Node order service using DynamoDB + SQS SDK imports (a large financial-services organization's cloud-native pattern).",
  "platformMinContract": "1.0.0",
  "fixturePath": "fixtures/monorepo/packages/ts-orders-dynamo",
  "changelog": "v0.1.0 initial",
  "nodes": [
    {
      "id": "orders-api",
      "nodeType": "service",
      "match": { "nameContains": "order" },
      "interfaces": ["GET /orders", "POST /orders"]
    },
    {
      "id": "orders-dynamo",
      "nodeType": "database",
      "match": { "nameContains": "Dynamo" }
    },
    {
      "id": "orders-queue",
      "nodeType": "network",
      "match": { "nameContains": "sqs" }
    }
  ],
  "relationships": [
    { "from": "orders-api", "to": "orders-dynamo", "kind": "connects" },
    { "from": "orders-api", "to": "orders-queue", "kind": "connects" }
  ],
  "mustNotDetect": [],
  "ignoreCalmNameContains": ["system"],
  "outOfScope": [],
  "expectedPlatformGaps": [
    "Dynamo/SQS may only appear after cloud import catalogue strategies (X2/X7)",
    "network kind may require contract evolution (topic/network)"
  ]
}
