{
  "$schema": "https://calm.finos.org/release/1.2/meta/calm.json",
  "unique-id": "coe-lab-py-ledger-worker",
  "name": "CoE Lab \u2014 Ledger Worker",
  "description": "Hand-authored gold architecture for the Flask ledger worker fixture (ledger_api.py + LedgerDb). Independent of the generator.",
  "metadata": [
    {
      "key": "x-lab-gold-source",
      "value": "hand-authored"
    },
    {
      "key": "x-lab-fixture",
      "value": "fixtures/monorepo/packages/py-ledger-worker"
    }
  ],
  "nodes": [
    {
      "unique-id": "ledger-api",
      "node-type": "service",
      "name": "Ledger API",
      "description": "Flask HTTP service for ledger entries (ledger_api.py).",
      "interfaces": [
        {
          "unique-id": "ledger-api-health",
          "type": "path-interface",
          "path": "GET /health"
        },
        {
          "unique-id": "ledger-api-post-entries",
          "type": "path-interface",
          "path": "POST /entries"
        },
        {
          "unique-id": "ledger-api-list-entries",
          "type": "path-interface",
          "path": "GET /entries"
        }
      ]
    },
    {
      "unique-id": "ledger-db",
      "node-type": "database",
      "name": "LedgerDb",
      "description": "SQLAlchemy-backed ledger store (ledger_db.py class LedgerDb)."
    },
    {
      "unique-id": "lab-system",
      "node-type": "system",
      "name": "Lab package system",
      "description": "Composite boundary for this fixture package \u2014 composed-of all architectural units."
    }
  ],
  "relationships": [
    {
      "unique-id": "ledger-api-connects-ledger-db",
      "description": "Ledger API uses LedgerDb for append/list persistence.",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "ledger-api"
          },
          "destination": {
            "node": "ledger-db"
          }
        }
      },
      "protocol": "JDBC"
    },
    {
      "unique-id": "lab-system-composed-of",
      "description": "System is composed of all architectural units in this package.",
      "relationship-type": {
        "composed-of": {
          "container": "lab-system",
          "nodes": [
            "ledger-api",
            "ledger-db"
          ]
        }
      }
    }
  ]
}
