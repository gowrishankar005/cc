# Dependencies
node_modules/
**/node_modules/

# Build output
pipeline/dist/
dist/
*.tsbuildinfo

# Code intelligence / scan scratch
.codegraph/
**/.codegraph/
graphify-out/
**/graphify-out/
*.codegraph.db

# Local sample-repo clones used for manual testing (never committed)
spikes/

# Local run-slice scan output used for manual testing (never committed)
test_llm/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Env / secrets / local tooling
.env
.env.*
!.env.example
.claude/*
# Shared, repo-scoped Claude Code Skills are real, reviewable tooling (parallel to
# .github/agents/, which is committed) -- carve them back out of the blanket ignore above.
# (A trailing-slash ignore on the parent dir itself would block git from ever looking inside
# it for negation rules -- ignoring only the dir's *contents* via .claude/* is what makes
# !.claude/skills able to re-include one entry.)
!.claude/skills
.idea/
.vscode/
*.swp
.DS_Store

# Local scratch folder (root-level only; docs/solution/ is tracked)
/soln/

# Logs and temp
*.log
tmp/
temp/
.cache/

# Package manager noise
npm-debug.log*
yarn-error.log*
.pnpm-store/

# CoE Lab evaluation outputs (regenerate via scripts)
coe-lab/eval-results/
coe-lab/generated/**
!coe-lab/generated/README.md

# Graphify scratch (tool writes into scanned trees)
**/.graphify-cache/
**/graphify-out/

# Residual review sessions (scratch by default — session packs may contain
# redacted source snippets and are not committed unless an architect
# deliberately archives one for audit; see Architect_Residual_Review_Session.md)
review-sessions/
